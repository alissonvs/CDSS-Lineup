# Servidor HTTP
PORT=3000
CLIENT_PORT=5173
NODE_ENV=production

# Configuração do PostgreSQL (gerenciado pelo Docker Compose)
POSTGRES_USER=cdsslineup
POSTGRES_PASSWORD=cdsslineup_secret
POSTGRES_DB=cdsslineup
POSTGRES_PORT=5432

# URL de Conexão com o PostgreSQL
# No Docker Compose local, a variável abaixo pode ficar comentada (o Compose conecta automaticamente no container 'postgres')
# DATABASE_URL=postgresql://cdsslineup:cdsslineup_secret@postgres:5432/cdsslineup
# Para banco externo ou remoto (ex: Dokploy, AWS RDS):
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# Chave da API DataDocked (opcional; sem a chave, o sistema usa o mock realista local)
DATADOCKED_API_KEY=sua_chave_datadocked_aqui

# Chave de API do CARTO para tiles de mapa (https://carto.com/basemaps/apikey)
VITE_CARTO_API_KEY=sua_chave_carto_aqui
# ========================================================
# PCS Lineup - Configurações de Ambiente (.env)
# ========================================================

# Servidor HTTP
PORT=3000
CLIENT_PORT=5173
NODE_ENV=production

# ========================================================
# 1. BANCO DE DADOS POSTGRESQL
# ========================================================
# OPÇÃO A: Deploy Dokploy / Produção / Banco Gerenciado (RECOMENDADO)
# Basta colar esta linha na aba "Environment" do Dokploy ou no seu .env local:
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# OPÇÃO B: Variáveis avulsas (para Docker Compose local com contêiner dedicado)
# Caso não forneça a DATABASE_URL, o sistema montará a conexão usando os campos abaixo:
POSTGRES_USER=cdsslineup
POSTGRES_PASSWORD=cdsslineup_secret
POSTGRES_DB=cdsslineup
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# ========================================================
# 2. INTEGRAÇÕES E TELEMETRIA
# ========================================================
# Praticagem de São Sebastião (SP Pilots) - Pauta de Serviços e Manobras
SP_PILOTS_USER=docasssb
SP_PILOTS_PASS="Docas#2019"
SP_PILOTS_URL=https://ssb.sppilots.com.br

# Chave da API DataDocked para telemetria satelital AIS (opcional; sem chave usa mock inteligente)
DATADOCKED_API_KEY=sua_chave_datadocked_aqui

# Chave de API do CARTO para tiles de alta fidelidade do mapa (obrigatório para mapas HD)
# Obtenha em: https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=sua_chave_carto_aqui

# ========================================================
# 3. AUTOMAÇÃO E AGENDAMENTO SISPORT (MELHORIA 8)
# ========================================================
# Ativação do worker periódico em segundo plano (true/false)
SISPORT_AUTO_SYNC_ENABLED=true

# Intervalo padrão em minutos (ex: 5, 10, 15, 30, 60 - mín: 2, máx: 1440)
SISPORT_SYNC_INTERVAL_MINUTES=15

# Modo de sincronização padrão: 'SISPORT_ONLY' (apenas porto) ou 'FULL_SYNC' (porto + AIS)
SISPORT_SYNC_MODE=SISPORT_ONLY
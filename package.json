{
  "name": "cdss-line-up-v2",
  "version": "1.0.0",
  "description": "SISPORT Line-Up Inteligente - Porto de São Sebastião (CDSS)",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix client install",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "sync:sisport": "tsx src/scripts/syncSisport.ts",
    "db:import-navios": "tsx src/scripts/importNavios.ts",
    "start": "node dist/server.js"
  },
  "keywords": [
    "cdss",
    "lineup",
    "port",
    "maritime",
    "datadocked"
  ],
  "author": "CDSS Engineering",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
